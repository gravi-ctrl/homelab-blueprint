# fastfetch welcome message
# Proper fastfetch size on phone screen but regular on bigger screen
if [ "$(tput cols)" -lt 80 ]; then
    fastfetch --logo-position right --logo "linux_small" --logo-width 1 --logo-padding 1
else
    fastfetch --logo "locos" --logo-width 5 --logo-padding 10
fi

# Define custom welcome message
function show_welcome_msg() {
    echo -e "\n\e[1;32m✓ System Online.\e[0m \e[3mEverything looks good.\e[0m"
    echo -e "💡 \e[90mTip: Lost? Type \e[1;33mwelcome\e[90m to view commands.\e[0m\n"
}

# Run welcome message on ssh connection
if [[ -n "$SSH_CONNECTION" ]]; then
    show_welcome_msg
fi

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# If you come from bash you might have to change your $PATH.
typeset -U PATH
export PATH="/opt/venv/bin:$HOME/bin:$HOME/.local/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/sbin:$PATH"

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load --- if set to "random", it will
# load a random theme each time Oh My Zsh is loaded, in which case,
# to know which specific one was loaded, run: echo $RANDOM_THEME
# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME="powerlevel10k/powerlevel10k"

# Which plugins would you like to load?
# Standard plugins can be found in $ZSH/plugins/
# Custom plugins may be added to $ZSH_CUSTOM/plugins/
# Example format: plugins=(rails git textmate ruby lighthouse)
# Add wisely, as too many plugins slow down shell startup.
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# ==============================================================================
# 1. WELCOME MESSAGE (Function)
# ==============================================================================
_cell() {
    local color=$1 key=$2 desc=$3 kw=$4 dw=$5
    printf "${color}%-${kw}s\e[0m \e[90m→\e[0m %-${dw}s" "$key" "$desc"
}
_blank() { printf "%-$(( $1 + 3 + $2 ))s" ""; }

function actual_show_welcome_msg() {
    local G="\e[32m" Y="\e[33m" P="\e[1;35m" R="\e[1;31m" D="\e[90m" W="\e[0m"

    # =========================================================
    # EDIT THESE TWO ARRAYS ONLY
    # Format: "key|description"
    # =========================================================
    local -a aliases=(
        "welcome|Briefing"
        "oracle|AI Assistant"
        "dps|Docker Table"
        "cert|Cert Manager"
        "vc-mount|Mount Vault"
        "vc-umount|Unmount Vault"
        "extract|Unzip/Tar"
        "guestwifi|WiFi Toggle"
        "stamp|Timestamp"
    )

    local -a shortcuts=(
        "Ctrl+R|FZF History"
        "Ctrl+T|FZF Files"
        "Alt+C|FZF Jump"
        "→ / End|Accept Suggest"
        "Ctrl+Spc|EXECUTE Sug"
        "|── nano ──"
        "Alt+N|Line Numbers"
        "Alt+M|Mouse"
    )

    # =========================================================
    # LAYOUT ENGINE
    # =========================================================
    local KW=10 DW=13
    local SEP="  "
    local total_a=${#aliases[@]}
    local total_s=${#shortcuts[@]}
    local col1=$(( (total_a + 1) / 2 > total_s ? (total_a + 1) / 2 : total_s ))
    local rows=$col1
    local div="${D}$(printf '%.0s─' {1..62})${W}"

    echo -e "\n${P}🚀 System Briefing for${W} ${R}$USER${W}"
    echo -e "$div"
    printf "  \e[90m%-$(( KW + 3 + DW ))s  %-$(( KW + 3 + DW ))s  %s\e[0m\n" \
        "Aliases" "" "Shortcuts"
    echo -e "$div"

    local i idx2 entry key desc
    for (( i = 0; i < rows; i++ )); do
        printf "  "

        # Alias col 1
        if (( i < col1 )); then
            entry="${aliases[$((i + 1))]}"
            key="${entry%%|*}"
            _cell "$G" "$key" "${entry#*|}" "$KW" "$DW"
        else
            _blank "$KW" "$DW"
        fi

        printf "$SEP"

        # Alias col 2
        idx2=$(( col1 + i + 1 ))
        if (( idx2 <= total_a )); then
            entry="${aliases[$idx2]}"
            key="${entry%%|*}"
            _cell "$G" "$key" "${entry#*|}" "$KW" "$DW"
        else
            _blank "$KW" "$DW"
        fi

        printf "$SEP"

        # Shortcuts col
        if (( i < total_s )); then
            entry="${shortcuts[$((i + 1))]}"
            key="${entry%%|*}"; desc="${entry#*|}"
            if [[ -z "$key" ]]; then
                printf "\e[90m%s\e[0m" "$desc"
            else
                _cell "$Y" "$key" "$desc" "$KW" "$DW"
            fi
        fi

        printf "\n"
    done

    echo -e "$div\n"
}

# ==============================================================================
# 2. ENVIRONMENT & PATHS
# ==============================================================================
export assets="/data/assets"
export HISTFILE=~/.zsh_history
export HISTSIZE=10000
export SAVEHIST=10000
umask 0022

# ==============================================================================
# 3. SMART HISTORY MANAGEMENT
# ==============================================================================
# Deduplication Logic
setopt HIST_IGNORE_ALL_DUPS    # Overwrite old duplicate with the new one
setopt HIST_SAVE_NO_DUPS       # Never write duplicates to the history file
setopt HIST_FIND_NO_DUPS       # Don't show duplicates when searching
setopt HIST_EXPIRE_DUPS_FIRST  # Clear duplicates first when history is full
setopt EXTENDED_HISTORY        # Record timestamps
setopt SHARE_HISTORY           # Sync history across all open terminals
setopt HIST_IGNORE_SPACE       # LEADING SPACE = NOT SAVED (Use for passwords/typos)

# Junk Command Filter (Prevents these from cluttering history)
HISTORY_IGNORE="(ls|ll|pwd|exit|clear|reboot|history|zsh|htop|top)"

zshaddhistory() {
    local cmd="${1%%$'\n'}" # Strip trailing newline
    # If command is in junk list, return 1 to reject it
    if [[ "$cmd" =~ ^($HISTORY_IGNORE)([[:space:]].*|$) ]]; then
        return 1
    fi
    return 0
}

