# Telegram Config
TELEGRAM_VERGIL_BOT_TOKEN=''
TELEGRAM_CHAT_ID=''

# --- COMMANDS ---
# Syntax: 
#   CMD_commandName="shell command here"
#   MUTE_commandName="true" (Optional: Silences raw output on successful run. Useful if the script has its own internal Telegram alert)
# TIMEOUT_commandName="900" (Optional: Every command is killed if it runs too long - default 600s, set globally with `VERGIL_TIMEOUT` unless defined with TIMEOUT)

CMD_backup="bash ~/scripts/backup.sh"
CMD_ping="ping -c 3 google.com"
CMD_deploy="/opt/rabbit-hole/gitops-deploy.sh"

TIMEOUT_backup="1800"
MUTE_deploy="true"
